# Build outputs
target/
project/target/
project/project/
.bsp/
.metals/
.bloop/
.scala-build/
metals.sbt

# IDEs and editors
.idea/
.vscode/
*.iml

# Secrets and local environment (never committed)
.env*
*.pem
*.key
.claude/settings.local.json
id_rsa*
id_ed25519*
*.p12
*.jks
*.pfx
credentials*
*.secret.tfvars

# Terraform local state and caches
.terraform/
*.tfstate*
.terraform.tfstate.lock.info
*.tfplan
terraform.tfvars
*.auto.tfvars
*.tfvars
!*.tfvars.example

# Generated script outputs at the repo root: plan/package/deploy/pipeline
# records and archived evidence
/build/
/evidence/

# Datasets: raw downloads stay local
datasets/raw/

# Generated test marker (written only by sbt markTestRun)
.claude/.last-test-run

# Local experiment and load-test outputs
experiments/**/local/
experiments/**/tmp/
load-tests/**/local/
load-tests/**/results-local/

# Module local-run outputs (generated, e.g. Spark Parquet); ignored at any depth.
# Exception: the entity-resolution local-run tree was committed in phase 05 and
# stays tracked until a human decides to untrack it.
local-run/
!modules/entity-resolution/local-run/

# OS noise
.DS_Store
